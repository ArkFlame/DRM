# Replace certificate locations; enable TLS using your existing ACME infrastructure.
# Bind the Next.js server to 127.0.0.1:3000; only Nginx is public.
server {
    listen 443 ssl http2;
    server_name drm.arkflame.com;
    ssl_certificate /etc/letsencrypt/live/drm.arkflame.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/drm.arkflame.com/privkey.pem;
    client_max_body_size 132k;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite these values; do not preserve untrusted inbound client headers.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 10s;
    }
}
server {
    listen 80;
    server_name drm.arkflame.com;
    return 301 https://$host$request_uri;
}
